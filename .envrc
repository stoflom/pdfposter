# -*- mode: sh -*-
ls $(direnv_layout_dir) | grep python
__has_pyenv=$?
if [ $__has_pyenv -ne 0  ] ; then
    layout_python3
	python -m pip install -r requirements.txt
else
    path_add PATH $(ls -d $(direnv_layout_dir)/python-*/bin)
fi

#path_add PYTHONPATH $PWD

if [ $__has_pyenv -ne 0  ] ; then
    python -m pip install -e .
fi
